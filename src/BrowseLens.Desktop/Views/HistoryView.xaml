<UserControl x:Class="BrowseLens.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="Segoe UI, sans-serif">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center" 
                         FontSize="13" BorderBrush="#CBD5E1" />

                <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedDateFilter}" SelectedValuePath="Content"
                          Padding="8,6" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13">
                    <ComboBoxItem Content="Today" IsSelected="True" />
                    <ComboBoxItem Content="Last 7 Days" />
                    <ComboBoxItem Content="Last 30 Days" />
                    <ComboBoxItem Content="All History" />
                </ComboBox>

                <Button Grid.Column="2" Command="{Binding RefreshCommand}" 
                        Content="Refresh" Background="#2563EB" Foreground="White" FontWeight="SemiBold" 
                        Padding="16,6" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Summary & Stats Bar -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
        </Border>

        <!-- Sessions DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" HorizontalGridLinesBrush="#F1F5F9"
                      Background="Transparent" BorderThickness="0" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Started (Local)" Binding="{Binding StartedTimeString}" Width="150" />
                    <DataGridTextColumn Header="Ended" Binding="{Binding EndedTimeString}" Width="90" />
                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" FontWeight="SemiBold" Width="140" />
                    <DataGridTextColumn Header="Page Title" Binding="{Binding Title}" Width="200" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" FontWeight="Bold" Width="90" />
                    <DataGridTextColumn Header="End Reason" Binding="{Binding EndReason}" Width="100" />
                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                    <DataGridTemplateColumn Header="Action" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#FEE2E2" Foreground="#DC2626" FontSize="11" FontWeight="SemiBold"
                                        Padding="6,2" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

