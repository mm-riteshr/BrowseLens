<UserControl x:Class="BrowseLens.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="Segoe UI, sans-serif">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            
            <!-- Tracking Pause Banner (Visible when paused) -->
            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrackingStatusText}" FontWeight="SemiBold" FontSize="14" Foreground="#92400E" />
                        <TextBlock Text="Browser tab switches and URLs are not recorded while tracking is paused." FontSize="12" Foreground="#B45309" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding TogglePauseCommand}" 
                            Content="{Binding PauseButtonText}" 
                            Background="#D97706" Foreground="White" FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Active Tab Hero Card -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE FOREGROUND TAB" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                        <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="{Binding ActiveTabState}" FontSize="11" FontWeight="SemiBold" Foreground="#4338CA" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding ActiveTabTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,8,0,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding ActiveTabUrl}" FontSize="13" Foreground="#2563EB" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Today's Highlights Row -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TODAY'S FOREGROUND TIME" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding TodayForegroundTime}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,2" />
                        <TextBlock Text="Active focused browsing time today" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TODAY'S VISITS &amp; SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding TodayVisitsCount}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,2" />
                        <TextBlock Text="Tab activations and navigation intervals recorded" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resource Usage Cards Grid (Chrome & Edge) -->
            <TextBlock Text="BROWSER PROCESS RESOURCE MONITOR" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10" />
            
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Chrome Card -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Google Chrome" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChromeStatus}" Value="Connected">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChromeStatus}" Value="Paused">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ChromeStatus}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChromeStatus}" Value="Connected">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ChromeStatus}" Value="Paused">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ChromeProcessCount, StringFormat='{}{0} processes'}" FontSize="12" Foreground="#64748B" />
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <TextBlock Text="Current RAM (Working Set):" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding ChromeCurrentRam}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Peak RAM (15-min Window):" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding ChromePeakRam}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Current CPU (Normalized):" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding ChromeCurrentCpu}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="15-min Average CPU:" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding ChromeAvgCpu}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="15-min Peak CPU:" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding ChromePeakCpu}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Edge Card -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Microsoft Edge" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EdgeStatus}" Value="Connected">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EdgeStatus}" Value="Paused">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding EdgeStatus}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EdgeStatus}" Value="Connected">
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EdgeStatus}" Value="Paused">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding EdgeProcessCount, StringFormat='{}{0} processes'}" FontSize="12" Foreground="#64748B" />
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <TextBlock Text="Current RAM (Working Set):" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding EdgeCurrentRam}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Peak RAM (15-min Window):" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding EdgePeakRam}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Current CPU (Normalized):" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding EdgeCurrentCpu}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="15-min Average CPU:" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding EdgeAvgCpu}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="15-min Peak CPU:" FontSize="13" Foreground="#64748B" />
                            <TextBlock Text="{Binding EdgePeakCpu}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Metric Scope Disclaimer Notice -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,20">
                <TextBlock Text="Notice: Metrics represent whole browser process CPU% (normalized across machine logical cores) and Working Set RAM. No per-tab or per-extension attribution is claimed or fabricated in Version 1."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
            </Border>

            <!-- Top Domains Quick Glance -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="TOP WEBSITES TODAY" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                    
                    <ItemsControl ItemsSource="{Binding TopDomainsToday}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedDuration}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="16,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding VisitCount, StringFormat='{}{0} visits'}" FontSize="12" Foreground="#64748B" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

